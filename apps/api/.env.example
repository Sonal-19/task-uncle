DATABASE_URL=postgres://localhost:5432/task_uncle
# 4500 in dev (Vite proxies /api there), 4600 in production (nginx proxies /api/)
PORT=4500
SESSION_DAYS=30
# Production only: the site's origin(s), comma separated
# ALLOWED_ORIGINS=https://taskuncle.com,https://tu.u4.lol
# SMTP for password-reset codes (leave SMTP_HOST empty in dev: the code is logged and 123456 is accepted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Task Uncle <no-reply@example.com>"
# Web Push (reminders when the app is closed). Generate once per environment:
#   bunx web-push generate-vapid-keys
# Changing the keys invalidates every device's subscription (they re-subscribe on next open).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taskuncle.app
# Timezone used for a user's quiet hours / due times until their browser reports one
DEFAULT_TIMEZONE=Asia/Kolkata

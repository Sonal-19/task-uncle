{
  "name": "task-uncle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --if-present --workspaces --parallel dev",
    "build": "bun run --if-present --workspaces --parallel build",
    "typecheck": "bun run --if-present --workspaces --parallel typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "icons": "bun scripts/icons.ts",
    "db:push": "bun run --cwd apps/api db:push",
    "db:seed": "bun run --cwd apps/api db:seed",
    "deploy": "zsh scripts/deploy-all.sh",
    "deploy:backend": "zsh scripts/deploy-backend.sh",
    "deploy:frontend": "zsh scripts/deploy-frontend.sh"
  },
  "workspaces": {
    "catalog": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "elysia": "1.4.30",
      "@elysiajs/eden": "1.4.9",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "drizzle-orm": "1.0.0-rc.4",
      "drizzle-kit": "1.0.0-rc.4",
      "@biomejs/biome": "2.5.12",
      "typescript": "7.0.2"
    },
    "packages": [
      "apps/*"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.1",
    "sharp": "^0.35.5",
    "typescript": "7.0.2"
  }
}
